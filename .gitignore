# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Creatives: brief.json (the source recipe) is tracked; the rendered outputs
# (mp4, png posters, zips) are local build artifacts regenerated on demand by
# scripts/render.mjs and scripts/render-video.mjs, so they are git-ignored to
# keep the repo light. Delete a render and re-run the script to rebuild it.
/creatives/**/*.mp4
/creatives/**/*.png
/creatives/**/*.jpg
/creatives/**/*.jpeg
/creatives/**/*.webp
/creatives/**/*.gif
/creatives/*/*.zip
# A HyperFrames film's project dir is the recipe (composition HTML, storyboard,
# brief, fonts), so it is re-included from the media ignores above. Derived and
# heavy content inside it stays ignored: renders land next to brief.json,
# snapshots and packet caches are regenerable, and the staged media copies are
# re-copied from products/<slug>/assets/ (BRIEF.md lists the sources).
!/creatives/**/hyperframes/**
/creatives/**/hyperframes/renders/
/creatives/**/hyperframes/snapshots/
/creatives/**/hyperframes/node_modules/
/creatives/**/hyperframes/.hyperframes/
/creatives/**/hyperframes/capture/assets/
/creatives/**/hyperframes/assets/*.mp4
#
# DISABLED (reinstatable): the old workboard rule promoted approved creatives
# into creatives-live/. Uncomment to turn creatives/ fully into a git-ignored
# WIP board instead:
# /creatives/*
# !/creatives/.gitkeep

# HyperFrames demo reference: the composition is tracked, its staged clips are
# not (they are copies of products/general/assets/clips/ - see the demo README).
/docs/motion/demos/**/assets/*.mp4
